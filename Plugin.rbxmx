<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<External>null</External><External>nil</External>
<Item class="Script" referent="RBXLAUASTUDIOPLUGIN1"><Properties><string name="Name">LauaStudioPlugin</string><bool name="Enabled">true</bool><ProtectedString name="Source"><![CDATA[--!strict
local studioPlugin = plugin
if not studioPlugin then return end

local VERSION = "0.2.1"
local PROJECT_NAME = "LauaStudioProject"
local SOURCES_NAME = "Sources"
local SNAPSHOTS_NAME = "Snapshots"
local OUTPUT_NAME = "LauaCompiled"
local SOURCE_OWNER = "LauaSourceId"
local OUTPUT_OWNER = "LauaGeneratedFrom"
local MAX_IMPORT = 200
local CONFIRM_SECONDS = 8
-- Always fetch the compiler from the official GitHub repository.
-- A short-lived ModuleScript is used only to load the downloaded source.
local COMPILER_URL = "https://raw.githubusercontent.com/Thegreatestprogrammerthatseverlived/laua/main/transpiler/transpiler.luau"
local compiler: any = nil
local compilerVersion = "Unavailable"
local compilerLoading = false

local function fetchCompiler(): string
    if compilerLoading then error("A compiler download is already in progress") end
    compilerLoading = true
    local ok, result = pcall(function()
        local source = game:GetService("HttpService"):GetAsync(COMPILER_URL, true)
        if #source < 10000 or #source > 1000000 then error("Unexpected compiler download size") end
        if not source:match('^%s*local%s+Transpiler%s*=%s*%{') or not source:match('return%s+Transpiler%s*$') then
            error("The GitHub response is not a Laua transpiler")
        end

        local temporary = Instance.new("ModuleScript")
        temporary.Name = "__LauaGitHubCompilerTemporary"
        temporary.Parent = script
        local loadedOk, loaded = pcall(function()
            game:GetService("ScriptEditorService"):UpdateSourceAsync(temporary, function(_previous: string): string
                return source
            end)
            if game:GetService("ScriptEditorService"):GetEditorSource(temporary) ~= source then
                error("Studio did not accept the downloaded compiler source")
            end
            return require(temporary)
        end)
        temporary:Destroy()
        if not loadedOk then error(loaded, 0) end
        if type(loaded) ~= "table" or type(loaded.Transpile) ~= "function" then
            error("Downloaded source did not return a Laua compiler with Transpile")
        end

        -- Only replace the working compiler after the download and require succeed.
        compiler = loaded
        compilerVersion = tostring(loaded.Version or "Unknown")
        return compilerVersion
    end)
    compilerLoading = false
    if not ok then error("GitHub compiler update failed: " .. tostring(result), 0) end
    return result :: string
end

local function getCompiler(): any
    if compiler ~= nil then return compiler end
    while compilerLoading do task.wait() end
    if compiler ~= nil then return compiler end
    fetchCompiler()
    return compiler
end

local function projectRoot(create: boolean): Folder?
    local storage = game:GetService("ServerStorage")
    local root = storage:FindFirstChild(PROJECT_NAME)
    if root and not root:IsA("Folder") then error("ServerStorage." .. PROJECT_NAME .. " must be a Folder") end
    if not root and create then
        root = Instance.new("Folder")
        root.Name = PROJECT_NAME
        root.Parent = storage
    end
    return root :: Folder?
end

local function childFolder(parent: Instance, name: string, create: boolean): Folder?
    local existing = parent:FindFirstChild(name)
    if existing and not existing:IsA("Folder") then error(parent:GetFullName() .. "." .. name .. " must be a Folder") end
    if not existing and create then
        existing = Instance.new("Folder")
        existing.Name = name
        existing.Parent = parent
    end
    return existing :: Folder?
end

local function sourcesRoot(create: boolean): Folder?
    local root = projectRoot(create)
    if not root then return nil end
    return childFolder(root, SOURCES_NAME, create)
end

local function snapshotsRoot(create: boolean): Folder?
    local root = projectRoot(create)
    if not root then return nil end
    return childFolder(root, SNAPSHOTS_NAME, create)
end

local function outputRoot(kind: string, create: boolean): Folder?
    local parent: Instance
    local name: string
    if kind == "Script" then
        parent = game:GetService("ServerScriptService")
        name = "LauaGeneratedScripts"
    elseif kind == "LocalScript" then
        parent = game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts")
        name = "LauaGeneratedLocalScripts"
    else
        parent = game:GetService("ReplicatedStorage")
        name = OUTPUT_NAME
    end
    return childFolder(parent, name, create)
end

local function relativePath(root: Instance, value: Instance): {string}
    local parts = {}
    local current: Instance? = value
    while current and current ~= root do
        table.insert(parts, 1, current.Name)
        current = current.Parent
    end
    if current ~= root then error("Source is outside the Laua project") end
    return parts
end

local function validName(name: string): boolean
    return name:match("^[%a_][%w_]*$") ~= nil and #name <= 70
end

local function sourceGuid(source: StringValue): string
    local id = source:GetAttribute(SOURCE_OWNER)
    if type(id) ~= "string" or id == "" then error(source:GetFullName() .. " is missing its Laua source ID") end
    return id
end

local function listSources(): {StringValue}
    local root = sourcesRoot(false)
    local out: {StringValue} = {}
    if not root then return out end
    for _, descendant in root:GetDescendants() do
        if descendant:IsA("StringValue") then table.insert(out, descendant) end
    end
    table.sort(out, function(a, b)
        return table.concat(relativePath(root, a), "/") < table.concat(relativePath(root, b), "/")
    end)
    return out
end

local function targetClass(source: StringValue): string
    local kind = source:GetAttribute("LauaOutputKind")
    if kind == "Script" or kind == "LocalScript" then return kind end
    return "ModuleScript"
end

local function makeTargetPath(source: StringValue, create: boolean): (Folder?, string)
    local root = sourcesRoot(false)
    if not root then error("No Laua source project exists") end
    local segments = relativePath(root, source)
    local name = table.remove(segments)
    if not name then error("Source has no name") end
    local folder = outputRoot(targetClass(source), create)
    if not folder then return nil, name end
    for _, segment in segments do
        folder = childFolder(folder, segment, create)
        if not folder then return nil, name end
    end
    return folder, name
end

local function projectWrite(label: string, callback: () -> ())
    local history = game:GetService("ChangeHistoryService")
    local recording = history:TryBeginRecording("Laua " .. label, "Laua: " .. label)
    if not recording then error("Studio could not begin an undo/redo recording. Exit Play mode and retry.") end
    local ok, err = pcall(callback)
    history:FinishRecording(recording, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel)
    if not ok then error(err, 0) end
end

local function addSource(name: string, kind: string, language: string, text: string, relativeFolders: {string}?): StringValue
    if not validName(name) then error("File names must start with a letter or _, followed by letters, digits, or _") end
    local root = sourcesRoot(true)
    if not root then error("Could not create source folder") end
    local folder = root
    for _, segment in relativeFolders or {} do
        if not validName(segment) then error("Invalid folder name: " .. segment) end
        local nextFolder = childFolder(folder, segment, true)
        if not nextFolder then error("Failed to create source folder") end
        folder = nextFolder
    end
    if folder:FindFirstChild(name) then error("A file named '" .. name .. "' already exists in this folder") end
    local value = Instance.new("StringValue")
    value.Name = name
    value.Value = text
    value:SetAttribute(SOURCE_OWNER, game:GetService("HttpService"):GenerateGUID(false))
    value:SetAttribute("LauaOutputKind", kind)
    value:SetAttribute("LauaLanguage", language)
    value.Parent = folder
    return value
end

local function sourceLanguage(source: StringValue): string
    return source:GetAttribute("LauaLanguage") == "Luau" and "Luau" or "Laua"
end

local function buildSource(source: StringValue): string
    if sourceLanguage(source) == "Luau" then return source.Value end
    return getCompiler().Transpile(source.Value, {Mode = "Development", OutputStyle = "Readable"})
end

local function writeGenerated(source: StringValue, code: string): string
    local sourceId = sourceGuid(source)
    local sourceParent, name = makeTargetPath(source, false)
    local previous = if sourceParent then sourceParent:FindFirstChild(name) else nil
    if not previous then
        local root = outputRoot(targetClass(source), false)
        if root then
            for _, item in root:GetDescendants() do
                if item:IsA("LuaSourceContainer") and item:GetAttribute(OUTPUT_OWNER) == sourceId then
                    error("Generated output for " .. source.Name .. " is still at " .. item:GetFullName() .. ". Rename it safely before recompiling.")
                end
            end
        end
    end
    local storedSnapshots = snapshotsRoot(false)
    local snapshot = if storedSnapshots then storedSnapshots:FindFirstChild(sourceId) else nil
    if snapshot and not snapshot:IsA("StringValue") then error("Snapshot entry has the wrong type") end
    if previous then
        if previous.ClassName ~= targetClass(source) then error("Output name is occupied by a different class: " .. previous:GetFullName()) end
        if previous:GetAttribute(OUTPUT_OWNER) ~= sourceId then error("Refusing to overwrite a script not owned by this Laua source: " .. previous:GetFullName()) end
        if not snapshot then error("Refusing to overwrite an existing output with no previous compilation snapshot") end
        local editorText = game:GetService("ScriptEditorService"):GetEditorSource(previous :: LuaSourceContainer)
        if editorText ~= (snapshot :: StringValue).Value then error("Generated script was edited outside Laua: " .. previous:GetFullName() .. ". Resolve the conflict manually.") end
        if editorText == code then return "Unchanged" end
    end

    projectWrite("Compile " .. source.Name, function()
        local folder, targetName = makeTargetPath(source, true)
        if not folder then error("Unable to create output folder") end
        local target = previous
        if not target then
            target = Instance.new(targetClass(source))
            target.Name = targetName
            target:SetAttribute(OUTPUT_OWNER, sourceId)
            target.Parent = folder
        end
        local wasEnabled = if previous and previous:IsA("BaseScript") then previous.Enabled else false
        if target:IsA("BaseScript") then target.Enabled = false end
        local expected = if previous and snapshot then (snapshot :: StringValue).Value else ""
        game:GetService("ScriptEditorService"):UpdateSourceAsync(target :: LuaSourceContainer, function(old: string): string
            if previous and old ~= expected then
                error("Generated script changed while compiling; refusing to overwrite " .. target:GetFullName())
            end
            return code
        end)
        local current = game:GetService("ScriptEditorService"):GetEditorSource(target :: LuaSourceContainer)
        if current ~= code then error("Studio refused to update " .. target:GetFullName() .. "; output was not committed") end
        local snapshots = snapshotsRoot(true)
        if not snapshots then error("Missing snapshot root") end
        local entry = snapshot
        if not entry then
            entry = Instance.new("StringValue")
            entry.Name = sourceId
            entry.Parent = snapshots
        end
        (entry :: StringValue).Value = code
        if target:IsA("BaseScript") then target.Enabled = if previous then wasEnabled else true end
    end)
    return "Compiled"
end

local toolbar = studioPlugin:CreateToolbar("Laua")
local toolbarButton = toolbar:CreateButton("Laua Studio", "Open the Laua project editor", "rbxassetid://0")
local widget = studioPlugin:CreateDockWidgetPluginGuiAsync("LauaStudioWorkspaceV1", DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, true, false, 760, 650, 430, 360))
widget.Title = "Laua Studio " .. VERSION

local function element(className: string, parent: Instance, props: {[string]: any}): any
    local object: any = Instance.new(className)
    for key, value in props do object[key] = value end
    object.Parent = parent
    return object
end

local outer = element("Frame", widget, {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(26, 27, 37), BorderSizePixel = 0})
local header = element("Frame", outer, {Size = UDim2.new(1, -20, 0, 42), Position = UDim2.fromOffset(10, 10), BackgroundTransparency = 1})
element("TextLabel", header, {Size = UDim2.fromScale(1, 1), Text = "Laua Studio  •  v3.30", TextColor3 = Color3.fromRGB(235, 226, 255), Font = Enum.Font.GothamBold, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1})
local buttonBar = element("Frame", outer, {Size = UDim2.new(1, -20, 0, 68), Position = UDim2.fromOffset(10, 53), BackgroundTransparency = 1})
local primary = element("ScrollingFrame", buttonBar, {Size = UDim2.new(1, 0, 0, 33), BackgroundTransparency = 1, CanvasSize = UDim2.fromOffset(560, 0), ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 2, BorderSizePixel = 0})
local secondary = element("ScrollingFrame", buttonBar, {Size = UDim2.new(1, 0, 0, 33), Position = UDim2.fromOffset(0, 36), BackgroundTransparency = 1, CanvasSize = UDim2.fromOffset(670, 0), ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 2, BorderSizePixel = 0})
element("UIListLayout", primary, {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder})
element("UIListLayout", secondary, {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder})

local function action(name: string, width: number, parent: Instance?): TextButton
    return element("TextButton", parent or primary, {Size = UDim2.fromOffset(width, 30), Text = name, BackgroundColor3 = Color3.fromRGB(94, 66, 148), TextColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true})
end

local createButton = action("New", 58)
local saveButton = action("Save", 60)
local compileButton = action("Compile", 81)
local checkButton = action("Check", 65)
local allButton = action("Compile All", 96)
local autoButton = action("Auto: Off", 86)
local refreshButton = action("Refresh", 76)
local duplicateButton = action("Duplicate", 84, secondary)
local renameButton = action("Rename", 78, secondary)
local deleteButton = action("Delete", 75, secondary)
local revealButton = action("Open Output", 104, secondary)
local importButton = action("Import Selected", 123, secondary)
local updateCompilerButton = action("Refresh Compiler", 133, secondary)

local searchBox = element("TextBox", outer, {Position = UDim2.fromOffset(10, 130), Size = UDim2.new(0, 180, 0, 28), Text = "", PlaceholderText = "Filter files...", ClearTextOnFocus = false, TextColor3 = Color3.fromRGB(246, 241, 255), PlaceholderColor3 = Color3.fromRGB(172, 165, 191), BackgroundColor3 = Color3.fromRGB(47, 47, 65), Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left})
local filePane = element("ScrollingFrame", outer, {Position = UDim2.fromOffset(10, 164), Size = UDim2.new(0, 180, 1, -217), BackgroundColor3 = Color3.fromRGB(35, 36, 49), BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y})
element("UIListLayout", filePane, {Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder})
local editorPanel = element("Frame", outer, {Position = UDim2.fromOffset(200, 130), Size = UDim2.new(1, -210, 1, -183), BackgroundColor3 = Color3.fromRGB(33, 34, 47), BorderSizePixel = 0})
local nameBox = element("TextBox", editorPanel, {Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -136, 0, 30), Text = "", PlaceholderText = "Name or Folder/Name", ClearTextOnFocus = false, TextColor3 = Color3.fromRGB(255, 255, 255), PlaceholderColor3 = Color3.fromRGB(176, 173, 189), BackgroundColor3 = Color3.fromRGB(53, 54, 70), Font = Enum.Font.Code, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left})
local typeButton = element("TextButton", editorPanel, {Position = UDim2.new(1, -118, 0, 8), Size = UDim2.fromOffset(110, 30), Text = "ModuleScript", BackgroundColor3 = Color3.fromRGB(69, 59, 99), TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamMedium, TextSize = 11})
local editor = element("TextBox", editorPanel, {Position = UDim2.fromOffset(8, 45), Size = UDim2.new(1, -16, 1, -53), Text = "", PlaceholderText = "Create a source, then write Laua here.", MultiLine = true, TextWrapped = false, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextEditable = true, Font = Enum.Font.Code, TextSize = 14, TextColor3 = Color3.fromRGB(231, 228, 243), BackgroundColor3 = Color3.fromRGB(20, 22, 32)})
local status = element("TextLabel", outer, {Position = UDim2.new(0, 10, 1, -43), Size = UDim2.new(1, -20, 0, 33), Text = "Ready", TextColor3 = Color3.fromRGB(205, 208, 224), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Font = Enum.Font.Gotham, TextSize = 12})

local selected: StringValue? = nil
local editorBaseline = ""
local outputKind = "ModuleScript"
local autoEnabled = studioPlugin:GetSetting("LauaAutoCompile") == true
local changingSelection = false
local compileBusy = false
local sourceConnections: {[Instance]: RBXScriptConnection} = {}
local trackedRoot: Folder? = nil
local descAddedConnection: RBXScriptConnection? = nil
local descRemovingConnection: RBXScriptConnection? = nil
local sourceNameConnections: {[Instance]: RBXScriptConnection} = {}
local pendingAuto: {[Instance]: number} = {}
local confirmation: {id: string, source: StringValue, expires: number}? = nil
local refreshing = false

local function showStatus(message: string, failed: boolean?)
    status.Text = message
    status.TextColor3 = if failed then Color3.fromRGB(255, 145, 145) else Color3.fromRGB(194, 222, 198)
    if failed then warn("[Laua Studio] " .. message) end
end

local function updateAutoText()
    autoButton.Text = if autoEnabled then "Auto: On" else "Auto: Off"
end
updateAutoText()

local function pickSource(source: StringValue?)
    selected = source
    confirmation = nil
    studioPlugin:SetSetting("LauaSelectedSourceId", if source then source:GetAttribute(SOURCE_OWNER) else "")
    changingSelection = true
    editorBaseline = if source then source.Value else ""
    if source then
        nameBox.Text = source.Name
        editor.Text = source.Value
        outputKind = targetClass(source)
    else
        nameBox.Text = ""
        editor.Text = ""
        outputKind = "ModuleScript"
    end
    typeButton.Text = outputKind
    changingSelection = false
end

local function saveSelected(): boolean
    if not selected then showStatus("Select a source first", true); return false end
    if not selected:IsDescendantOf(game) then showStatus("Source was deleted; press Refresh", true); return false end
    if editor.Text == selected.Value then
        editorBaseline = selected.Value
        return true
    end
    if selected.Value ~= editorBaseline then
        showStatus("Source changed outside the Laua editor; copy your edits before Refresh to avoid losing changes", true)
        return false
    end
    local sourceToSave: StringValue = selected
    local value = editor.Text
    local ok, err = pcall(function()
        projectWrite("Save " .. sourceToSave.Name, function()
            sourceToSave.Value = value
        end)
    end)
    if not ok then showStatus(tostring(err), true); return false end
    editorBaseline = sourceToSave.Value
    showStatus("Saved " .. sourceToSave.Name)
    return true
end


local function uniqueName(root: Instance, base: string): string
    if not root:FindFirstChild(base) then return base end
    for suffix = 2, 10000 do
        local candidate = base .. tostring(suffix)
        if not root:FindFirstChild(candidate) then return candidate end
    end
    error("Too many similarly named sources")
end

local function parseNewName(raw: string): ({string}, string, string)
    local path = raw:gsub("\\", "/"):gsub("^%s+", ""):gsub("%s+$", "")
    local language = "Laua"
    if path:sub(-5) == ".laua" then path = path:sub(1, -6)
    elseif path:sub(-5) == ".luau" then path = path:sub(1, -6); language = "Luau" end
    local parts = path:split("/")
    if #parts > 16 then error("Folder nesting is limited to 15 levels") end
    for _, part in parts do
        if not validName(part) then error("Invalid file or folder name: " .. part) end
    end
    local name = table.remove(parts)
    if not name then error("Enter a file name") end
    return parts, name, language
end

local function siblingSourceName(source: StringValue, suffix: string): string
    return uniqueName(source.Parent :: Instance, source.Name .. suffix)
end

local function trackedOutput(source: StringValue): (LuaSourceContainer?, StringValue?)
    local root = outputRoot(targetClass(source), false)
    local id = sourceGuid(source)
    local match: LuaSourceContainer? = nil
    if root then
        for _, child in root:GetDescendants() do
            if child:IsA("LuaSourceContainer") and child:GetAttribute(OUTPUT_OWNER) == id then
                if match then error("Multiple generated outputs share this source ID: " .. id) end
                match = child
            end
        end
    end
    local snapshots = snapshotsRoot(false)
    local snapshot = if snapshots then snapshots:FindFirstChild(id) else nil
    if snapshot and not snapshot:IsA("StringValue") then error("Snapshot has an unexpected type") end
    return match, snapshot :: StringValue?
end

local function validateOutputOwnership(source: StringValue): (LuaSourceContainer?, StringValue?)
    local output, snapshot = trackedOutput(source)
    if output then
        if not snapshot then error("No snapshot for " .. output:GetFullName()) end
        if game:GetService("ScriptEditorService"):GetEditorSource(output) ~= snapshot.Value then
            error("Generated output was modified manually: " .. output:GetFullName())
        end
    end
    return output, snapshot
end

local function compileOne(source: StringValue): boolean
    local ok, result = pcall(function()
        local compiled = buildSource(source)
        return writeGenerated(source, compiled)
    end)
    if not ok then showStatus(source.Name .. ": " .. tostring(result), true); return false end
    pendingAuto[source] = nil
    showStatus(source.Name .. ": " .. tostring(result) .. " to Studio (" .. targetClass(source) .. ")")
    return true
end

local function compileSelected()
    if compileBusy then return end
    if not selected then showStatus("Select a source first", true); return end
    if not saveSelected() then return end
    compileBusy = true
    compileOne(selected)
    compileBusy = false
end

local function refreshList()
    if refreshing then return end
    refreshing = true
    for _, child in filePane:GetChildren() do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    local root = sourcesRoot(false)
    local filter = searchBox.Text:lower()
    local count = 0
    for index, source in listSources() do
        local path = if root then table.concat(relativePath(root, source), "/") else source.Name
        local extension = if sourceLanguage(source) == "Luau" then ".luau" else ".laua"
        if filter ~= "" and not (path .. extension):lower():find(filter, 1, true) then continue end
        count += 1
        local item = element("TextButton", filePane, {LayoutOrder = index, Size = UDim2.new(1, -8, 0, 29), Text = "  " .. path .. extension, TextColor3 = Color3.fromRGB(232, 227, 249), BackgroundColor3 = if source == selected then Color3.fromRGB(88, 66, 141) else Color3.fromRGB(47, 47, 65), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Code, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd})
        item.MouseButton1Click:Connect(function()
            if selected and editor.Text ~= selected.Value and not saveSelected() then return end
            pickSource(source)
            refreshList()
        end)
    end
    if count == 0 then
        element("TextLabel", filePane, {Size = UDim2.new(1, -8, 0, 38), Text = if filter ~= "" then "No matching sources" else "No sources yet", BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 176, 201), Font = Enum.Font.Gotham, TextSize = 12})
    end
    refreshing = false
end

local function scheduleAuto(source: StringValue)
    if not autoEnabled then return end
    local version = (pendingAuto[source] or 0) + 1
    pendingAuto[source] = version
    task.delay(0.65, function()
        if pendingAuto[source] ~= version or not autoEnabled then return end
        if not source:IsDescendantOf(game) then pendingAuto[source] = nil; return end
        if compileBusy then scheduleAuto(source); return end
        if selected == source and editor.Text ~= source.Value then scheduleAuto(source); return end
        pendingAuto[source] = nil
        compileBusy = true
        local ok, err = pcall(function() compileOne(source) end)
        compileBusy = false
        if not ok then showStatus(tostring(err), true) end
    end)
end

local function markSource(source: StringValue)
    if sourceConnections[source] then return end
    sourceConnections[source] = source:GetPropertyChangedSignal("Value"):Connect(function()
        if source == selected and not editor:IsFocused() and not changingSelection then
            editor.Text = source.Value
            editorBaseline = source.Value
        end
        scheduleAuto(source)
    end)
    sourceNameConnections[source] = source:GetPropertyChangedSignal("Name"):Connect(function()
        if selected == source then nameBox.Text = source.Name end
        task.defer(refreshList)
    end)
end

local function bindProject()
    local root = sourcesRoot(false)
    if root == trackedRoot then return end
    if descAddedConnection then descAddedConnection:Disconnect(); descAddedConnection = nil end
    if descRemovingConnection then descRemovingConnection:Disconnect(); descRemovingConnection = nil end
    for source, conn in sourceConnections do
        conn:Disconnect()
        sourceConnections[source] = nil
    end
    for source, conn in sourceNameConnections do
        conn:Disconnect()
        sourceNameConnections[source] = nil
    end
    table.clear(pendingAuto)
    trackedRoot = root
    if not root then return end
    for _, source in listSources() do markSource(source) end
    descAddedConnection = root.DescendantAdded:Connect(function(item)
        if item:IsA("StringValue") then markSource(item); task.defer(refreshList) end
    end)
    descRemovingConnection = root.DescendantRemoving:Connect(function(item)
        local connection = sourceConnections[item]
        if connection then connection:Disconnect(); sourceConnections[item] = nil end
        local nameConnection = sourceNameConnections[item]
        if nameConnection then nameConnection:Disconnect(); sourceNameConnections[item] = nil end
        pendingAuto[item] = nil
        if item == selected then task.defer(function()
            if selected == item then pickSource(nil); refreshList() end
        end) end
    end)
end

createButton.MouseButton1Click:Connect(function()
    if selected and editor.Text ~= selected.Value and not saveSelected() then return end
    local raw = nameBox.Text
    if raw == "" or (selected and raw == selected.Name) then
        local root = sourcesRoot(false)
        if root then raw = uniqueName(root, "NewScript") else raw = "NewScript" end
    end
    local ok, result = pcall(function()
        local folders, name, language = parseNewName(raw)
        local created: StringValue? = nil
        projectWrite("Create source", function()
            created = addSource(name, outputKind, language, "--!strict\n", folders)
        end)
        return created
    end)
    if not ok then showStatus(tostring(result), true); return end
    bindProject()
    pickSource(result :: StringValue)
    refreshList()
    showStatus("Created " .. (result :: StringValue).Name .. " on the first click. Edit, Save or Compile.")
end)

duplicateButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to duplicate", true); return end
    if not saveSelected() then return end
    local original: StringValue = selected
    local root = sourcesRoot(false)
    if not root then return end
    local folders = relativePath(root, original)
    table.remove(folders)
    local name = siblingSourceName(original, "Copy")
    local ok, result = pcall(function()
        local created: StringValue? = nil
        projectWrite("Duplicate source", function()
            created = addSource(name, targetClass(original), sourceLanguage(original), original.Value, folders)
        end)
        return created
    end)
    if not ok then showStatus(tostring(result), true); return end
    pickSource(result :: StringValue)
    refreshList()
    showStatus("Duplicated " .. original.Name .. " as " .. name .. " (new source ID)")
end)

renameButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to rename", true); return end
    if not saveSelected() then return end
    local source: StringValue = selected
    local requested = nameBox.Text
    if requested == source.Name then showStatus("Enter a different name above, then click Rename"); return end
    local ok, err = pcall(function()
        if not validName(requested) then error("Rename accepts only a file name without folders or an extension") end
        if source.Parent and source.Parent:FindFirstChild(requested) then error("Source name already exists: " .. requested) end
        local output, snapshot = validateOutputOwnership(source)
        if output and output.Parent and output.Parent:FindFirstChild(requested) then error("Generated output name already exists: " .. requested) end
        projectWrite("Rename source", function()
            source.Name = requested
            if output then output.Name = requested end
        end)
        if output and not snapshot then error("Missing output snapshot") end
    end)
    if not ok then showStatus(tostring(err), true); nameBox.Text = source.Name; return end
    refreshList()
    showStatus("Renamed source and matching generated output to " .. requested)
end)

deleteButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to delete", true); return end
    if not saveSelected() then return end
    local source: StringValue = selected
    if not confirmation or confirmation.id ~= "delete" or confirmation.source ~= source or os.clock() > confirmation.expires then
        confirmation = {id = "delete", source = source, expires = os.clock() + CONFIRM_SECONDS}
        showStatus("Click Delete again within 8 seconds to remove " .. source.Name .. " and its unmodified generated output")
        return
    end
    confirmation = nil
    local ok, err = pcall(function()
        local output, snapshot = validateOutputOwnership(source)
        projectWrite("Delete source", function()
            if output then output:Destroy() end
            if snapshot then snapshot:Destroy() end
            source:Destroy()
        end)
    end)
    if not ok then showStatus(tostring(err), true); return end
    pickSource(nil)
    refreshList()
    showStatus("Deleted source and safe owned output. Use Studio Undo to reverse.")
end)

revealButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source first", true); return end
    local ok, result = pcall(function()
        local output = trackedOutput(selected :: StringValue)
        if not output then error("No generated output yet; compile the source first") end
        game:GetService("Selection"):Set({output})
        game:GetService("ScriptEditorService"):OpenScriptDocumentAsync(output, {})
        return output:GetFullName()
    end)
    if not ok then showStatus(tostring(result), true); return end
    showStatus("Opened " .. tostring(result))
end)

checkButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source first", true); return end
    if not saveSelected() then return end
    if compileBusy then return end
    compileBusy = true
    local started = os.clock()
    local source = selected :: StringValue
    local ok, result = pcall(function() return buildSource(source) end)
    compileBusy = false
    if not ok then showStatus(source.Name .. " compilation failed: " .. tostring(result), true); return end
    local text = result :: string
    local _, lines = text:gsub("\n", "\n")
    showStatus("Transpiled: " .. source.Name .. " | " .. #text .. " bytes, " .. (lines + 1) .. " lines, " .. string.format("%.1f ms", (os.clock() - started) * 1000) .. " (not validated by Studio Script Analysis)")
end)

saveButton.MouseButton1Click:Connect(function()
    saveSelected()
end)
compileButton.MouseButton1Click:Connect(compileSelected)
allButton.MouseButton1Click:Connect(function()
    if compileBusy then return end
    if selected and not saveSelected() then return end
    compileBusy = true
    local passed, failed = 0, 0
    for _, source in listSources() do
        if compileOne(source) then passed += 1 else failed += 1 end
    end
    compileBusy = false
    showStatus("Compile All: " .. passed .. " succeeded, " .. failed .. " failed", failed > 0)
end)

autoButton.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    studioPlugin:SetSetting("LauaAutoCompile", autoEnabled)
    bindProject()
    if not autoEnabled then table.clear(pendingAuto) end
    updateAutoText()
    showStatus(if autoEnabled then "Auto compile on saved source changes enabled" else "Auto compile disabled")
end)

refreshButton.MouseButton1Click:Connect(function()
    bindProject()
    refreshList()
    if selected and not selected:IsDescendantOf(game) then pickSource(nil) end
    showStatus("Source list refreshed")
end)

typeButton.MouseButton1Click:Connect(function()
    if not selected then
        outputKind = if outputKind == "ModuleScript" then "Script" elseif outputKind == "Script" then "LocalScript" else "ModuleScript"
        typeButton.Text = outputKind
        return
    end
    showStatus("Output kind is fixed once a source is created. Create a new source for a different kind.", true)
end)


searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    refreshList()
end)

editor:GetPropertyChangedSignal("Text"):Connect(function()
    if changingSelection or not selected then return end
    if editor.Text ~= editorBaseline then
        status.Text = "Unsaved edits to " .. selected.Name .. " — click Save or Compile"
        status.TextColor3 = Color3.fromRGB(255, 210, 125)
    end
end)

editor.FocusLost:Connect(function()
    if selected and not changingSelection then saveSelected() end
end)

importButton.MouseButton1Click:Connect(function()
    if selected and not saveSelected() then return end
    local selection = game:GetService("Selection"):Get()
    if #selection ~= 1 then showStatus("Select one exported LauaProject, Sources folder, Modules folder, or ModuleScript", true); return end
    local picked = selection[1]
    local importRoot = picked
    local importKind = "Luau"
    if not picked:IsA("ModuleScript") then
        local sourceFolder = picked:FindFirstChild("Sources")
        local moduleFolder = picked:FindFirstChild("Modules")
        if sourceFolder and sourceFolder:IsA("Folder") then
            importRoot = sourceFolder
            importKind = "Source"
        elseif moduleFolder and moduleFolder:IsA("Folder") then
            importRoot = moduleFolder
        elseif picked.Name == "Sources" and picked:IsA("Folder") then
            importKind = "Source"
        end
    end
    local entries = {}
    local proposed: {[string]: boolean} = {}
    local existingRoot = sourcesRoot(false)
    local candidates = if importRoot:IsA("ModuleScript") then {importRoot} else importRoot:GetDescendants()
    for _, item in candidates do
        if importKind == "Source" and not item:IsA("StringValue") then continue end
        if importKind ~= "Source" and not item:IsA("ModuleScript") then continue end
        local folders = {}
        if item ~= importRoot then
            local cursor = item.Parent
            while cursor and cursor ~= importRoot do
                table.insert(folders, 1, cursor.Name)
                cursor = cursor.Parent
            end
        end
        local name = item.Name
        local language = "Luau"
        if importKind == "Source" then
            if name:sub(-5) == ".laua" then
                name = name:sub(1, -6)
                language = "Laua"
            elseif name:sub(-5) == ".luau" then
                name = name:sub(1, -6)
            else
                showStatus("Studio source file is missing .laua or .luau extension: " .. name, true)
                return
            end
        end
        if not validName(name) then showStatus("Invalid source name: " .. name, true); return end
        local key = table.concat(folders, "/") .. "/" .. name
        if proposed[key] then showStatus("Duplicate source path: " .. key, true); return end
        proposed[key] = true
        local f = existingRoot
        for _, segment in folders do
            if not validName(segment) then showStatus("Invalid folder name: " .. segment, true); return end
            if f then
                local nextPart = f:FindFirstChild(segment)
                if nextPart and not nextPart:IsA("Folder") then showStatus("Folder path conflicts with source: " .. segment, true); return end
                f = nextPart :: Folder?
            end
        end
        if f and f:FindFirstChild(name) then showStatus("Source already exists: " .. key, true); return end
        local content: string
        if importKind == "Source" then
            content = (item :: StringValue).Value
        else
            local ok, text = pcall(function() return game:GetService("ScriptEditorService"):GetEditorSource(item :: ModuleScript) end)
            if not ok then showStatus("Cannot read " .. name .. ": " .. tostring(text), true); return end
            content = text
        end
        table.insert(entries, {name = name, folders = folders, source = content, language = language})
        if #entries > MAX_IMPORT then showStatus("Import is limited to " .. MAX_IMPORT .. " files per operation", true); return end
    end
    if #entries == 0 then showStatus("Selection contains no importable source files or ModuleScripts", true); return end
    local ok, err = pcall(function()
        projectWrite("Import Studio sources", function()
            for _, entry in entries do addSource(entry.name, "ModuleScript", entry.language, entry.source, entry.folders) end
        end)
    end)
    if not ok then showStatus(tostring(err), true); return end
    bindProject()
    refreshList()
    showStatus("Imported " .. #entries .. (importKind == "Source" and " editable source files." or " compiled Luau modules (original Laua syntax unavailable)."))
end)

updateCompilerButton.MouseButton1Click:Connect(function()
    if compilerLoading then showStatus("Compiler download is already running"); return end
    if compileBusy then showStatus("Wait for the current compilation to finish", true); return end
    showStatus("Downloading the latest Laua transpiler from GitHub...")
    local ok, version = pcall(fetchCompiler)
    if not ok then
        showStatus(tostring(version) .. (compiler ~= nil and " (keeping compiler v" .. compilerVersion .. ")" or " (no compiler loaded)"), true)
        return
    end
    showStatus("Loaded Laua compiler v" .. tostring(version) .. " from GitHub")
end)

local function refreshAfterHistory()
    task.defer(function()
        bindProject()
        if selected and not selected:IsDescendantOf(game) then
            pickSource(nil)
        elseif selected and not editor:IsFocused() and editor.Text == editorBaseline then
            pickSource(selected)
        end
        refreshList()
    end)
end
local undoConnection = game:GetService("ChangeHistoryService").OnUndo:Connect(refreshAfterHistory)
local redoConnection = game:GetService("ChangeHistoryService").OnRedo:Connect(refreshAfterHistory)

toolbarButton.Click:Connect(function() widget.Enabled = not widget.Enabled end)
widget:BindToClose(function() widget.Enabled = false end)
studioPlugin.Unloading:Connect(function()
    undoConnection:Disconnect()
    redoConnection:Disconnect()
    if descAddedConnection then descAddedConnection:Disconnect() end
    if descRemovingConnection then descRemovingConnection:Disconnect() end
    for _, conn in sourceConnections do conn:Disconnect() end
    for _, conn in sourceNameConnections do conn:Disconnect() end
    table.clear(pendingAuto)
end)

bindProject()
local lastId = studioPlugin:GetSetting("LauaSelectedSourceId")
if type(lastId) == "string" and lastId ~= "" then
    for _, source in listSources() do
        if source:GetAttribute(SOURCE_OWNER) == lastId then pickSource(source); break end
    end
end
refreshList()
showStatus("Connecting to GitHub for the latest Laua transpiler...")
task.spawn(function()
    local ok, version = pcall(fetchCompiler)
    if not ok then
        showStatus(tostring(version) .. " — click Refresh Compiler to retry", true)
        return
    end
    showStatus("Ready. Laua compiler v" .. tostring(version) .. " loaded from GitHub. New creates a source in one click.")
end)
]]></ProtectedString></Properties>
</Item></roblox>
