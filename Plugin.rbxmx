    Instance = {"new"}
}
local suggestedItems: {{name: string, kind: string}} = {}
local replacementStart = 0
local replacementEnd = 0
local activeAnalysis = 0
local suppressEditorCompletion = false

local function trimSourceLine(line: string): string
    return (line:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function normalizedClassHeader(line: string): string?
    local value = trimSourceLine(line)
    while true do
        local word = value:match("^(%a+)%s+")
        if word ~= "export" and word ~= "final" and word ~= "abstract" then break end
        value = value:sub(#word + 2)
    end
    return value:match("^class%s+([%a_][%w_]*)%f[^%w_]")
end

local function resolveImportedSource(modulePath: string, fromSource: StringValue?): StringValue?
    local root = sourcesRoot(false)
    local source = fromSource or selected
    if not root or not source then return nil end
    local parent: Instance = source.Parent
    local rest = modulePath
    if not rest:match("^%.%./") and not rest:match("^%./") then return nil end
    while rest:sub(1, 3) == "../" do
        if parent == root then return nil end
        parent = parent.Parent
        rest = rest:sub(4)
    end
    if rest:sub(1, 2) == "./" then rest = rest:sub(3) end
    if rest == "" then return nil end
    for segment in rest:gmatch("[^/]+") do
        if not segment:match("^[%a_][%w_]*$") then return nil end
        local nextNode = parent:FindFirstChild(segment)
        if not nextNode then return nil end
        parent = nextNode
    end
    if not parent:IsA("StringValue") then return nil end
    if parent == source then return nil end
    if sourceLanguage(parent) ~= "Laua" then return nil end
    return parent
end

local function exportedClassName(text: string): string?
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        local normalized = trimSourceLine(line)
        if normalized:match("^export%s+") then
            local name = normalizedClassHeader(normalized)
            if name then return name end
        end
    end
    return nil
end

local function validateDirectClassImports(text: string, fromSource: StringValue): (string?, number?)
    local lineNo = 0
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        lineNo += 1
        local trimmed = trimSourceLine(line)
        local original, alias, path = trimmed:match('^import%s+([%a_][%w_]*)%s+as%s+([%a_][%w_]*)%s+from%s+"([^"\n]+)"%s*$')
        if not original then original, alias, path = trimmed:match("^import%s+([%a_][%w_]*)%s+as%s+([%a_][%w_]*)%s+from%s+'([^'\n]+)'%s*$") end
        if original and path then
            local module = resolveImportedSource(path, fromSource)
            if module then
                local exported = exportedClassName(module.Value)
                if exported and exported ~= original then
                    return "Module '" .. path .. "' exports class '" .. exported .. "', not '" .. original .. "'", lineNo
                end
            end
        end
        local names, namedPath = trimmed:match('^import%s+%{(.-)%}%s+from%s+"([^"\n]+)"%s*$')
        if not names then names, namedPath = trimmed:match("^import%s+%{(.-)%}%s+from%s+'([^'\n]+)'%s*$") end
        if names and namedPath then
            local module = resolveImportedSource(namedPath, fromSource)
            if module then
                local exported = exportedClassName(module.Value)
                if exported then
                    return "Module '" .. namedPath .. "' directly returns class '" .. exported .. "'. Use import " .. exported .. " as Alias from '" .. namedPath .. "' instead", lineNo
                end
            end
        end
    end
    return nil, nil
end

local function getClassSymbols(text: string, caret: number, includeImports: boolean?): ({[string]: {[string]: string}}, {[string]: string}, {[string]: boolean}, string?)
    local classes: {[string]: {[string]: string}} = {}
    local variables: {[string]: string} = {}
    local symbols: {[string]: boolean} = {}
    local currentClass: string? = nil
    local classIndent = -1
    local caretClass: string? = nil
    local offset = 1
    for line in (text .. "\n"):gmatch("([^\n]*)\n") do
        local trimmed = trimSourceLine(line)
        local indent = #(line:match("^%s*") or "")
        if currentClass and trimmed == "end" and indent &lt;= classIndent then
            currentClass = nil
        end
        local className = normalizedClassHeader(line)
        if className then
            currentClass = className
            classIndent = indent
            classes[className] = classes[className] or {}
            symbols[className] = true
        end
        if offset &lt;= caret then caretClass = currentClass end
        local declaration = trimmed:match("^local%s+([%a_][%w_]*)") or trimmed:match("^const%s+([%a_][%w_]*)") or trimmed:match("^function%s+([%a_][%w_]*)")
        if declaration then symbols[declaration] = true end
        local localName, newType = trimmed:match("^local%s+([%a_][%w_]*)%s*=%s*new%s+([%a_][%w_]*)")
        if localName and newType then variables[localName] = newType end
        local typedName, typedClass = trimmed:match("^local%s+([%a_][%w_]*)%s*:%s*([%a_][%w_]*)")
        if typedName and typedClass and classes[typedClass] then variables[typedName] = typedClass end
        if currentClass and indent &gt; classIndent and trimmed ~= "" and not trimmed:match("^%-%-") then
            local member = trimmed:gsub("^public%s+", ""):gsub("^private%s+", ""):gsub("^protected%s+", ""):gsub("^static%s+", ""):gsub("^override%s+", ""):gsub("^final%s+", ""):gsub("^abstract%s+", "")
            local isStatic = trimmed:match("%f[%w_]static%s+") ~= nil
            local method = member:match("^function%s+([%a_][%w_]*)%s*%(")
            local getter = member:match("^get%s+([%a_][%w_]*)%s*%(")
            local setter = member:match("^set%s+([%a_][%w_]*)%s*%(")
            local field = member:match("^([%a_][%w_]*)%s*[:=]")
            if method then classes[currentClass][method] = if isStatic then "static method" else "method"
            elseif getter then classes[currentClass][getter] = "getter"
            elseif setter then classes[currentClass][setter] = "setter"
            elseif field then classes[currentClass][field] = if isStatic then "static field" else "field" end
        end
        offset += #line + 1
    end
    if includeImports ~= false then
        for line in (text .. "\n"):gmatch("([^\n]*)\n") do
            local trimmed = trimSourceLine(line)
            local original, alias, path = trimmed:match('^import%s+([%a_][%w_]*)%s+as%s+([%a_][%w_]*)%s+from%s+"([^"\n]+)"%s*$')
            if not original then original, alias, path = trimmed:match("^import%s+([%a_][%w_]*)%s+as%s+([%a_][%w_]*)%s+from%s+'([^'\n]+)'%s*$") end
            if not original then original, path = trimmed:match('^import%s+([%a_][%w_]*)%s+from%s+"([^"\n]+)"%s*$') end
            if not original then original, path = trimmed:match("^import%s+([%a_][%w_]*)%s+from%s+'([^'\n]+)'%s*$") end
            if original and path then
                local binding = alias or original
                symbols[binding] = true
                local remote = resolveImportedSource(path)
                if remote then
                    local className = exportedClassName(remote.Value)
                    if className and (not alias or original == className) then
                        local remoteClasses = getClassSymbols(remote.Value, #remote.Value + 1, false)
                        if remoteClasses[className] then classes[binding] = remoteClasses[className] end
                    end
                end
            end
            local named, namedPath = trimmed:match('^import%s+%{(.-)%}%s+from%s+"([^"\n]+)"%s*$')
            if not named then named, namedPath = trimmed:match("^import%s+%{(.-)%}%s+from%s+'([^'\n]+)'%s*$") end
            if named then
                for part in named:gmatch("[^,]+") do
                    local _, renamed = trimSourceLine(part):match("^([%a_][%w_]*)%s+as%s+([%a_][%w_]*)$")
                    local binding = renamed or trimSourceLine(part)
                    if binding:match("^[%a_][%w_]*$") then symbols[binding] = true end
                end
            end
        end
        for line in (text .. "\n"):gmatch("([^\n]*)\n") do
            local typedName, typedClass = trimSourceLine(line):match("^local%s+([%a_][%w_]*)%s*:%s*([%a_][%w_]*)")
            if typedName and typedClass and classes[typedClass] then variables[typedName] = typedClass end
        end
    end
    return classes, variables, symbols, caretClass
end

local function autocompleteContext(): (string, string?, string?, number, number)
    local text = editor.Text
    local cursor = editor.CursorPosition
    if cursor &lt; 1 then return "", nil, nil, 0, 0 end
    local before: string = string.sub(text, 1, cursor - 1)
    local lineStart = #before
    while lineStart &gt; 0 and string.sub(before, lineStart, lineStart) ~= "\n" do
        lineStart -= 1
    end
    local currentLine: string = string.sub(before, lineStart + 1)
    if string.match(currentLine, "%-%-[^\n]*$") then return "", nil, nil, 0, 0 end
    local receiver: string?, separator: string?, partial: string? = string.match(currentLine, "([%a_][%w_]*)([%.:])([%a_][%w_]*)$")
    if not receiver then
        receiver, separator = string.match(currentLine, "([%a_][%w_]*)([%.:])$")
        partial = ""
    end
    if receiver and separator then return partial or "", receiver, separator, cursor - #(partial or ""), cursor end
    partial = string.match(currentLine, "([%a_][%w_]*)$") or ""
    return partial, nil, nil, cursor - #partial, cursor
end

local function fillAutocomplete()
    autocompletePanel.Visible = false
    table.clear(suggestedItems)
    if not selected or not editor:IsFocused() or changingSelection or suppressEditorCompletion then return end
    if sourceLanguage(selected) ~= "Laua" then return end
    local typed, receiver, separator, startAt, endAt = autocompleteContext()
    if startAt == 0 or (not receiver and #typed &lt; 2) then return end
    replacementStart = startAt
    replacementEnd = endAt
    local classes, variables, symbols, classHere = getClassSymbols(editor.Text, startAt)
    local seen: {[string]: boolean} = {}
    local candidates: {{name: string, kind: string, sortName: string}} = {}
    local typedLower: string = string.lower(typed)
    local function add(name: string, kind: string)
        if seen[name] or name == typed then return end
        local lowerName: string = string.lower(name)
        if typed ~= "" and string.sub(lowerName, 1, #typed) ~= typedLower then return end
        seen[name] = true
        table.insert(candidates, {name = name, kind = kind, sortName = lowerName})
    end
    if receiver then
        local className = if receiver == "self" then classHere else variables[receiver] or (if classes[receiver] then receiver else nil)
        if className and classes[className] then
            local onClass = receiver ~= "self" and variables[receiver] == nil and classes[receiver] ~= nil
            if onClass then
                if separator == "." then add("new", "constructor") end
                for name, kind in classes[className] do
                    if separator == "." and (kind == "static method" or kind == "static field") then add(name, kind) end
                end
            else
                for name, kind in classes[className] do
                    if kind ~= "static method" and kind ~= "static field" and (separator == "." or kind == "method") then add(name, kind) end
                end
            end
        elseif standardMembers[receiver] then
            for _, name in standardMembers[receiver] do
                if separator == "." or name:match("^[A-Z]") then add(name, "Roblox / library") end
            end
        end
    else
        local before = string.sub(editor.Text, 1, math.max(0, startAt - 1))
        local lastLine = string.match(before, "[^\n]*$") or ""
        if string.match(lastLine, "^%s*import%s+[%a_][%w_]*$") or string.match(lastLine, "^%s*import%s+$") then
            for _, source in listSources() do
                if source ~= selected and sourceLanguage(source) == "Laua" then
                    local name = exportedClassName(source.Value)
                    if name then add(name, "Exported class") end
                end
            end
        end
        for _, keyword in completionKeywords do add(keyword, "Laua keyword") end
        for _, global in completionGlobals do add(global, "Luau / Roblox") end
        for name in symbols do add(name, "In this file") end
        for name in classes do add(name, "Class") end
    end
    table.sort(candidates, function(a: {name: string, kind: string, sortName: string}, b: {name: string, kind: string, sortName: string}): boolean
        if a.sortName == b.sortName then return a.name &lt; b.name end
        return a.sortName &lt; b.sortName
    end)
    for _, item in candidates do
        if #suggestedItems &gt;= 7 then break end
        table.insert(suggestedItems, item)
    end
    for _, child in autocompleteEntries:GetChildren() do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    if #suggestedItems == 0 then return end
    autocompletePanel.Visible = true
    for index, item in suggestedItems do
        local button = element("TextButton", autocompleteEntries, {LayoutOrder = index, Size = UDim2.new(1, -4, 0, 27), BackgroundColor3 = Color3.fromRGB(58, 55, 83), TextColor3 = Color3.fromRGB(235, 228, 250), Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Text = "  " .. item.name .. "  ·  " .. item.kind, ZIndex = 22})
        button.MouseButton1Click:Connect(function()
            if not selected then return end
            local text = editor.Text
            if replacementStart &lt; 1 or replacementEnd &gt; #text + 1 then return end
            local updated = text:sub(1, replacementStart - 1) .. item.name .. text:sub(replacementEnd)
            suppressEditorCompletion = true
            editor.Text = updated
            editor:CaptureFocus()
            editor.CursorPosition = replacementStart + #item.name
            editor.SelectionStart = -1
            autocompletePanel.Visible = false
            suppressEditorCompletion = false
        end)
    end
end

local function displayDiagnostics(diagnostics: {{line: number, character: number, message: string, severity: string}}, note: string?)
    for _, child in analysisEntries:GetChildren() do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    if #diagnostics == 0 then
        analysisHeader.Text = note or "Laua diagnostics · no transpiler errors found"
        analysisHeader.TextColor3 = Color3.fromRGB(160, 225, 177)
        return
    end
    analysisHeader.Text = "Laua diagnostics · " .. #diagnostics .. " issue(s)"
    analysisHeader.TextColor3 = Color3.fromRGB(250, 178, 169)
    for i, item in diagnostics do
        local shade = if item.severity == "Error" then Color3.fromRGB(255, 170, 170) else Color3.fromRGB(255, 215, 150)
        local button = element("TextButton", analysisEntries, {LayoutOrder = i, Size = UDim2.new(1, -6, 0, 25), BackgroundColor3 = Color3.fromRGB(49, 44, 57), Text = "  " .. item.severity .. " L" .. item.line .. ": " .. item.message, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = shade, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Code, TextSize = 11})
        button.MouseButton1Click:Connect(function()
            local current = editor.Text
            local line = 1
            local offset = 1
            while line &lt; item.line do
                local newline = current:find("\n", offset, true)
                if not newline then break end
                offset = newline + 1
                line += 1
            end
            editor:CaptureFocus()
            editor.CursorPosition = math.clamp(offset + item.character - 1, 1, #current + 1)
            editor.SelectionStart = -1
        end)
    end
end

local function runLiveAnalysis()
    if not selected then displayDiagnostics({}, "Laua diagnostics · select a source"); return end
    if sourceLanguage(selected) == "Luau" then
        displayDiagnostics({}, "Luau source · use Studio Script Analysis for Luau")
        return
    end
    if compiler == nil then
        displayDiagnostics({}, "Laua diagnostics · waiting for GitHub transpiler")
        return
    end
    local text = editor.Text
    local importError, importLine = validateDirectClassImports(text, selected)
    if importError then
        displayDiagnostics({{line = importLine or 1, character = 1, message = importError, severity = "Error"}})
        return
    end
    if #text &gt; 120000 then
        displayDiagnostics({}, "Laua diagnostics · large source, use Check")
        return
    end
    local ok, err = pcall(function()
        compiler.Transpile(text, {Mode = "Development", OutputStyle = "Readable"})
    end)
    if ok then
        displayDiagnostics({}, "Laua diagnostics · no transpiler errors found")
        return
    end
    local message = tostring(err)
    local line = tonumber(message:match("%(line%s+(%d+)%)")) or tonumber(message:match("[Ll]ine%s+(%d+)")) or tonumber(message:match(":(%d+):")) or 1
    message = message:gsub("^.-Laua semantic error%s*%(line%s*%d+%)%s*:%s*", "")
    message = message:gsub("^.-Invalid class member:%s*", "Invalid class member: ")
    message = message:match("([^\n]+)") or message
    if #message &gt; 400 then message = message:sub(1, 400) end
    displayDiagnostics({{line = line, character = 1, message = message, severity = "Error"}})
end

local function scheduleLiveAnalysis()
    activeAnalysis += 1
    local revision = activeAnalysis
    task.delay(0.45, function()
        if revision ~= activeAnalysis or changingSelection then return end
        runLiveAnalysis()
    end)
end

local function pickSource(source: StringValue?)
    selected = source
    confirmation = nil
    studioPlugin:SetSetting("LauaSelectedSourceId", if source then source:GetAttribute(SOURCE_OWNER) else "")
    changingSelection = true
    editorBaseline = if source then source.Value else ""
    if source then
        nameBox.Text = source.Name
        editor.Text = source.Value
        outputKind = targetClass(source)
    else
        nameBox.Text = ""
        editor.Text = ""
        outputKind = "ModuleScript"
    end
    typeButton.Text = outputKind
    changingSelection = false
    autocompletePanel.Visible = false
    scheduleLiveAnalysis()
end

local function saveSelected(): boolean
    if not selected then showStatus("Select a source first", true); return false end
    if not selected:IsDescendantOf(game) then showStatus("Source was deleted; press Refresh", true); return false end
    if editor.Text == selected.Value then
        editorBaseline = selected.Value
        return true
    end
    if selected.Value ~= editorBaseline then
        showStatus("Source changed outside the Laua editor; copy your edits before Refresh to avoid losing changes", true)
        return false
    end
    local sourceToSave: StringValue = selected
    local value = editor.Text
    local ok, err = pcall(function()
        projectWrite("Save " .. sourceToSave.Name, function()
            sourceToSave.Value = value
        end)
    end)
    if not ok then showStatus(tostring(err), true); return false end
    editorBaseline = sourceToSave.Value
    showStatus("Saved " .. sourceToSave.Name)
    return true
end


local function uniqueName(root: Instance, base: string): string
    if not root:FindFirstChild(base) then return base end
    for suffix = 2, 10000 do
        local candidate = base .. tostring(suffix)
        if not root:FindFirstChild(candidate) then return candidate end
    end
    error("Too many similarly named sources")
end

local function parseNewName(raw: string): ({string}, string, string)
    local path = raw:gsub("\\", "/"):gsub("^%s+", ""):gsub("%s+$", "")
    local language = "Laua"
    if path:sub(-5) == ".laua" then path = path:sub(1, -6)
    elseif path:sub(-5) == ".luau" then path = path:sub(1, -6); language = "Luau" end
    local parts = path:split("/")
    if #parts &gt; 16 then error("Folder nesting is limited to 15 levels") end
    for _, part in parts do
        if not validName(part) then error("Invalid file or folder name: " .. part) end
    end
    local name = table.remove(parts)
    if not name then error("Enter a file name") end
    return parts, name, language
end

local function siblingSourceName(source: StringValue, suffix: string): string
    return uniqueName(source.Parent :: Instance, source.Name .. suffix)
end

local function trackedOutput(source: StringValue): (LuaSourceContainer?, StringValue?)
    local root = outputRoot(targetClass(source), false)
    local id = sourceGuid(source)
    local match: LuaSourceContainer? = nil
    if root then
        for _, child in root:GetDescendants() do
            if child:IsA("LuaSourceContainer") and child:GetAttribute(OUTPUT_OWNER) == id then
                if match then error("Multiple generated outputs share this source ID: " .. id) end
                match = child
            end
        end
    end
    local snapshots = snapshotsRoot(false)
    local snapshot = if snapshots then snapshots:FindFirstChild(id) else nil
    if snapshot and not snapshot:IsA("StringValue") then error("Snapshot has an unexpected type") end
    return match, snapshot :: StringValue?
end

local function validateOutputOwnership(source: StringValue): (LuaSourceContainer?, StringValue?)
    local output, snapshot = trackedOutput(source)
    if output then
        if not snapshot then error("No snapshot for " .. output:GetFullName()) end
        if game:GetService("ScriptEditorService"):GetEditorSource(output) ~= snapshot.Value then
            error("Generated output was modified manually: " .. output:GetFullName())
        end
    end
    return output, snapshot
end

local function compileOne(source: StringValue): boolean
    local ok, result = pcall(function()
        if sourceLanguage(source) == "Laua" then
            local importError = validateDirectClassImports(source.Value, source)
            if importError then error(importError) end
        end
        local compiled = buildSource(source)
        return writeGenerated(source, compiled)
    end)
    if not ok then showStatus(source.Name .. ": " .. tostring(result), true); return false end
    pendingAuto[source] = nil
    showStatus(source.Name .. ": " .. tostring(result) .. " to Studio (" .. targetClass(source) .. ")")
    return true
end

local function compileSelected()
    if compileBusy then return end
    if not selected then showStatus("Select a source first", true); return end
    if not saveSelected() then return end
    compileBusy = true
    compileOne(selected)
    compileBusy = false
end

local function refreshList()
    if refreshing then return end
    refreshing = true
    for _, child in filePane:GetChildren() do
        if child:IsA("GuiObject") then child:Destroy() end
    end
    local root = sourcesRoot(false)
    local filter = searchBox.Text:lower()
    local count = 0
    for index, source in listSources() do
        local path = if root then table.concat(relativePath(root, source), "/") else source.Name
        local extension = if sourceLanguage(source) == "Luau" then ".luau" else ".laua"
        if filter ~= "" and not (path .. extension):lower():find(filter, 1, true) then continue end
        count += 1
        local item = element("TextButton", filePane, {LayoutOrder = index, Size = UDim2.new(1, -8, 0, 29), Text = "  " .. path .. extension, TextColor3 = Color3.fromRGB(232, 227, 249), BackgroundColor3 = if source == selected then Color3.fromRGB(88, 66, 141) else Color3.fromRGB(47, 47, 65), TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Code, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd})
        item.MouseButton1Click:Connect(function()
            if selected and editor.Text ~= selected.Value and not saveSelected() then return end
            pickSource(source)
            refreshList()
        end)
    end
    if count == 0 then
        element("TextLabel", filePane, {Size = UDim2.new(1, -8, 0, 38), Text = if filter ~= "" then "No matching sources" else "No sources yet", BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(180, 176, 201), Font = Enum.Font.Gotham, TextSize = 12})
    end
    refreshing = false
end

local function scheduleAuto(source: StringValue)
    if not autoEnabled then return end
    local version = (pendingAuto[source] or 0) + 1
    pendingAuto[source] = version
    task.delay(0.65, function()
        if pendingAuto[source] ~= version or not autoEnabled then return end
        if not source:IsDescendantOf(game) then pendingAuto[source] = nil; return end
        if compileBusy then scheduleAuto(source); return end
        if selected == source and editor.Text ~= source.Value then scheduleAuto(source); return end
        pendingAuto[source] = nil
        compileBusy = true
        local ok, err = pcall(function() compileOne(source) end)
        compileBusy = false
        if not ok then showStatus(tostring(err), true) end
    end)
end

local function markSource(source: StringValue)
    if sourceConnections[source] then return end
    sourceConnections[source] = source:GetPropertyChangedSignal("Value"):Connect(function()
        if source == selected and not editor:IsFocused() and not changingSelection then
            editor.Text = source.Value
            editorBaseline = source.Value
        end
        scheduleAuto(source)
    end)
    sourceNameConnections[source] = source:GetPropertyChangedSignal("Name"):Connect(function()
        if selected == source then nameBox.Text = source.Name end
        task.defer(refreshList)
    end)
end

local function bindProject()
    local root = sourcesRoot(false)
    if root == trackedRoot then return end
    if descAddedConnection then descAddedConnection:Disconnect(); descAddedConnection = nil end
    if descRemovingConnection then descRemovingConnection:Disconnect(); descRemovingConnection = nil end
    for source, conn in sourceConnections do
        conn:Disconnect()
        sourceConnections[source] = nil
    end
    for source, conn in sourceNameConnections do
        conn:Disconnect()
        sourceNameConnections[source] = nil
    end
    table.clear(pendingAuto)
    trackedRoot = root
    if not root then return end
    for _, source in listSources() do markSource(source) end
    descAddedConnection = root.DescendantAdded:Connect(function(item)
        if item:IsA("StringValue") then markSource(item); task.defer(refreshList) end
    end)
    descRemovingConnection = root.DescendantRemoving:Connect(function(item)
        local connection = sourceConnections[item]
        if connection then connection:Disconnect(); sourceConnections[item] = nil end
        local nameConnection = sourceNameConnections[item]
        if nameConnection then nameConnection:Disconnect(); sourceNameConnections[item] = nil end
        pendingAuto[item] = nil
        if item == selected then task.defer(function()
            if selected == item then pickSource(nil); refreshList() end
        end) end
    end)
end

createButton.MouseButton1Click:Connect(function()
    if selected and editor.Text ~= selected.Value and not saveSelected() then return end
    local raw = nameBox.Text
    if raw == "" or (selected and raw == selected.Name) then
        local root = sourcesRoot(false)
        if root then raw = uniqueName(root, "NewScript") else raw = "NewScript" end
    end
    local ok, result = pcall(function()
        local folders, name, language = parseNewName(raw)
        local created: StringValue? = nil
        projectWrite("Create source", function()
            created = addSource(name, outputKind, language, "--!strict\n", folders)
        end)
        return created
    end)
    if not ok then showStatus(tostring(result), true); return end
    bindProject()
    pickSource(result :: StringValue)
    refreshList()
    showStatus("Created " .. (result :: StringValue).Name .. " on the first click. Edit, Save or Compile.")
end)

duplicateButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to duplicate", true); return end
    if not saveSelected() then return end
    local original: StringValue = selected
    local root = sourcesRoot(false)
    if not root then return end
    local folders = relativePath(root, original)
    table.remove(folders)
    local name = siblingSourceName(original, "Copy")
    local ok, result = pcall(function()
        local created: StringValue? = nil
        projectWrite("Duplicate source", function()
            created = addSource(name, targetClass(original), sourceLanguage(original), original.Value, folders)
        end)
        return created
    end)
    if not ok then showStatus(tostring(result), true); return end
    pickSource(result :: StringValue)
    refreshList()
    showStatus("Duplicated " .. original.Name .. " as " .. name .. " (new source ID)")
end)

renameButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to rename", true); return end
    if not saveSelected() then return end
    local source: StringValue = selected
    local requested = nameBox.Text
    if requested == source.Name then showStatus("Enter a different name above, then click Rename"); return end
    local ok, err = pcall(function()
        if not validName(requested) then error("Rename accepts only a file name without folders or an extension") end
        if source.Parent and source.Parent:FindFirstChild(requested) then error("Source name already exists: " .. requested) end
        local output, snapshot = validateOutputOwnership(source)
        if output and output.Parent and output.Parent:FindFirstChild(requested) then error("Generated output name already exists: " .. requested) end
        projectWrite("Rename source", function()
            source.Name = requested
            if output then output.Name = requested end
        end)
        if output and not snapshot then error("Missing output snapshot") end
    end)
    if not ok then showStatus(tostring(err), true); nameBox.Text = source.Name; return end
    refreshList()
    showStatus("Renamed source and matching generated output to " .. requested)
end)

deleteButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source to delete", true); return end
    if not saveSelected() then return end
    local source: StringValue = selected
    if not confirmation or confirmation.id ~= "delete" or confirmation.source ~= source or os.clock() &gt; confirmation.expires then
        confirmation = {id = "delete", source = source, expires = os.clock() + CONFIRM_SECONDS}
        showStatus("Click Delete again within 8 seconds to remove " .. source.Name .. " and its unmodified generated output")
        return
    end
    confirmation = nil
    local ok, err = pcall(function()
        local output, snapshot = validateOutputOwnership(source)
        projectWrite("Delete source", function()
            if output then output:Destroy() end
            if snapshot then snapshot:Destroy() end
            source:Destroy()
        end)
    end)
    if not ok then showStatus(tostring(err), true); return end
    pickSource(nil)
    refreshList()
    showStatus("Deleted source and safe owned output. Use Studio Undo to reverse.")
end)

revealButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source first", true); return end
    local ok, result = pcall(function()
        local output = trackedOutput(selected :: StringValue)
        if not output then error("No generated output yet; compile the source first") end
        game:GetService("Selection"):Set({output})
        game:GetService("ScriptEditorService"):OpenScriptDocumentAsync(output, {})
        return output:GetFullName()
    end)
    if not ok then showStatus(tostring(result), true); return end
    showStatus("Opened " .. tostring(result))
end)

checkButton.MouseButton1Click:Connect(function()
    if not selected then showStatus("Select a source first", true); return end
    if not saveSelected() then return end
    if compileBusy then return end
    compileBusy = true
    local started = os.clock()
    local source = selected :: StringValue
    local ok, result = pcall(function() return buildSource(source) end)
    compileBusy = false
    if not ok then
        showStatus(source.Name .. " transpilation failed: " .. tostring(result), true)
        runLiveAnalysis()
        return
    end
    local text = result :: string
    local _, lines = text:gsub("\n", "\n")
    showStatus("Transpiled: " .. source.Name .. " | " .. #text .. " bytes, " .. (lines + 1) .. " lines, " .. string.format("%.1f ms", (os.clock() - started) * 1000) .. " (not validated by Studio Script Analysis)")
end)

saveButton.MouseButton1Click:Connect(function()
    saveSelected()
end)
compileButton.MouseButton1Click:Connect(compileSelected)
allButton.MouseButton1Click:Connect(function()
    if compileBusy then return end
    if selected and not saveSelected() then return end
    compileBusy = true
    local passed, failed = 0, 0
    for _, source in listSources() do
        if compileOne(source) then passed += 1 else failed += 1 end
    end
    compileBusy = false
    showStatus("Compile All: " .. passed .. " succeeded, " .. failed .. " failed", failed &gt; 0)
end)

autoButton.MouseButton1Click:Connect(function()
    autoEnabled = not autoEnabled
    studioPlugin:SetSetting("LauaAutoCompile", autoEnabled)
    bindProject()
    if not autoEnabled then table.clear(pendingAuto) end
    updateAutoText()
    showStatus(if autoEnabled then "Auto compile on saved source changes enabled" else "Auto compile disabled")
end)

refreshButton.MouseButton1Click:Connect(function()
    bindProject()
    refreshList()
    if selected and not selected:IsDescendantOf(game) then pickSource(nil) end
    showStatus("Source list refreshed")
end)

typeButton.MouseButton1Click:Connect(function()
    if not selected then
        outputKind = if outputKind == "ModuleScript" then "Script" elseif outputKind == "Script" then "LocalScript" else "ModuleScript"
        typeButton.Text = outputKind
        return
    end
    showStatus("Output kind is fixed once a source is created. Create a new source for a different kind.", true)
end)


searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    refreshList()
end)

editor:GetPropertyChangedSignal("Text"):Connect(function()
    local currentSource = selected
    if changingSelection or currentSource == nil then return end
    scheduleLiveAnalysis()
    task.defer(fillAutocomplete)
    if editor.Text ~= editorBaseline then
        status.Text = "Unsaved edits to " .. currentSource.Name .. " — click Save or Compile"
        status.TextColor3 = Color3.fromRGB(255, 210, 125)
    end
end)

editor:GetPropertyChangedSignal("CursorPosition"):Connect(function()
    task.defer(fillAutocomplete)
end)
editor.Focused:Connect(function()
    task.defer(fillAutocomplete)
end)
editor.FocusLost:Connect(function()
    if selected and not changingSelection then saveSelected() end
    task.delay(0.2, function()
        if not editor:IsFocused() then autocompletePanel.Visible = false end
    end)
end)

importButton.MouseButton1Click:Connect(function()
    if selected and not saveSelected() then return end
    local selection = game:GetService("Selection"):Get()
    if #selection ~= 1 then showStatus("Select one exported LauaProject, Sources folder, Modules folder, or ModuleScript", true); return end
    local picked = selection[1]
    local importRoot = picked
    local importKind = "Luau"
    if not picked:IsA("ModuleScript") then
        local sourceFolder = picked:FindFirstChild("Sources")
        local moduleFolder = picked:FindFirstChild("Modules")
        if sourceFolder and sourceFolder:IsA("Folder") then
            importRoot = sourceFolder
            importKind = "Source"
        elseif moduleFolder and moduleFolder:IsA("Folder") then
            importRoot = moduleFolder
        elseif picked.Name == "Sources" and picked:IsA("Folder") then
            importKind = "Source"
        end
    end
    local entries = {}
    local proposed: {[string]: boolean} = {}
    local existingRoot = sourcesRoot(false)
    local candidates = if importRoot:IsA("ModuleScript") then {importRoot} else importRoot:GetDescendants()
    for _, item in candidates do
        if importKind == "Source" and not item:IsA("StringValue") then continue end
        if importKind ~= "Source" and not item:IsA("ModuleScript") then continue end
        local folders = {}
        if item ~= importRoot then
            local cursor = item.Parent
            while cursor and cursor ~= importRoot do
                table.insert(folders, 1, cursor.Name)
                cursor = cursor.Parent
            end
        end
        local name = item.Name
        local language = "Luau"
        if importKind == "Source" then
            if name:sub(-5) == ".laua" then
                name = name:sub(1, -6)
                language = "Laua"
            elseif name:sub(-5) == ".luau" then
                name = name:sub(1, -6)
            else
                showStatus("Studio source file is missing .laua or .luau extension: " .. name, true)
                return
            end
        end
        if not validName(name) then showStatus("Invalid source name: " .. name, true); return end
        local key = table.concat(folders, "/") .. "/" .. name
        if proposed[key] then showStatus("Duplicate source path: " .. key, true); return end
        proposed[key] = true
        local f = existingRoot
        for _, segment in folders do
            if not validName(segment) then showStatus("Invalid folder name: " .. segment, true); return end
            if f then
                local nextPart = f:FindFirstChild(segment)
                if nextPart and not nextPart:IsA("Folder") then showStatus("Folder path conflicts with source: " .. segment, true); return end
                f = nextPart :: Folder?
            end
        end
        if f and f:FindFirstChild(name) then showStatus("Source already exists: " .. key, true); return end
        local content: string
        if importKind == "Source" then
            content = (item :: StringValue).Value
        else
            local ok, text = pcall(function() return game:GetService("ScriptEditorService"):GetEditorSource(item :: ModuleScript) end)
            if not ok then showStatus("Cannot read " .. name .. ": " .. tostring(text), true); return end
            content = text
        end
        table.insert(entries, {name = name, folders = folders, source = content, language = language})
        if #entries &gt; MAX_IMPORT then showStatus("Import is limited to " .. MAX_IMPORT .. " files per operation", true); return end
    end
    if #entries == 0 then showStatus("Selection contains no importable source files or ModuleScripts", true); return end
    local ok, err = pcall(function()
        projectWrite("Import Studio sources", function()
            for _, entry in entries do addSource(entry.name, "ModuleScript", entry.language, entry.source, entry.folders) end
        end)
    end)
    if not ok then showStatus(tostring(err), true); return end
    bindProject()
    refreshList()
    showStatus("Imported " .. #entries .. (importKind == "Source" and " editable source files." or " compiled Luau modules (original Laua syntax unavailable)."))
end)

updateCompilerButton.MouseButton1Click:Connect(function()
    if compilerLoading then showStatus("Compiler download is already running"); return end
    if compileBusy then showStatus("Wait for the current compilation to finish", true); return end
    showStatus("Downloading the latest Laua transpiler from GitHub...")
    local ok, version = pcall(fetchCompiler)
    if not ok then
        showStatus(tostring(version) .. (compiler ~= nil and " (keeping compiler v" .. compilerVersion .. ")" or " (no compiler loaded)"), true)
        return
    end
    showStatus("Loaded Laua transpiler v" .. tostring(version) .. " from GitHub")
    scheduleLiveAnalysis()
end)

local function refreshAfterHistory()
    task.defer(function()
        bindProject()
        if selected and not selected:IsDescendantOf(game) then
            pickSource(nil)
        elseif selected and not editor:IsFocused() and editor.Text == editorBaseline then
            pickSource(selected)
        end
        refreshList()
    end)
end
local undoConnection = game:GetService("ChangeHistoryService").OnUndo:Connect(refreshAfterHistory)
local redoConnection = game:GetService("ChangeHistoryService").OnRedo:Connect(refreshAfterHistory)

toolbarButton.Click:Connect(function() widget.Enabled = not widget.Enabled end)
widget:BindToClose(function() widget.Enabled = false end)
studioPlugin.Unloading:Connect(function()
    undoConnection:Disconnect()
    redoConnection:Disconnect()
    if descAddedConnection then descAddedConnection:Disconnect() end
    if descRemovingConnection then descRemovingConnection:Disconnect() end
    for _, conn in sourceConnections do conn:Disconnect() end
    for _, conn in sourceNameConnections do conn:Disconnect() end
    table.clear(pendingAuto)
end)

bindProject()
local lastId = studioPlugin:GetSetting("LauaSelectedSourceId")
if type(lastId) == "string" and lastId ~= "" then
    for _, source in listSources() do
        if source:GetAttribute(SOURCE_OWNER) == lastId then pickSource(source); break end
    end
end
refreshList()
showStatus("Connecting to GitHub for the latest Laua transpiler...")
task.spawn(function()
    local ok, version = pcall(fetchCompiler)
    if not ok then
        showStatus(tostring(version) .. " — click Refresh Compiler to retry", true)
        return
    end
    showStatus("Ready. Laua transpiler v" .. tostring(version) .. " loaded from GitHub. Live lint and autocomplete enabled.")
    scheduleLiveAnalysis()
end)
</ProtectedString></Properties>
</Item></roblox>