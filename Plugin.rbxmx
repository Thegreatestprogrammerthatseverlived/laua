}
local completionGlobals = {"print", "warn", "error", "assert", "require", "game", "workspace", "script", "Instance", "Enum", "Vector3", "CFrame", "UDim2", "Color3", "math", "table", "string", "task", "coroutine", "pcall", "ipairs", "pairs", "type", "typeof", "tonumber", "tostring", "cancelScope"}
local standardMembers: {[string]: {string}} = {
    game = {"GetService", "FindFirstChild", "WaitForChild", "IsLoaded", "BindToClose", "Workspace", "Players", "ReplicatedStorage", "ServerStorage", "ServerScriptService"},
    workspace = {"CurrentCamera", "Gravity", "GetDescendants", "GetChildren", "FindFirstChild", "Raycast", "GetPartBoundsInBox", "GetPartBoundsInRadius"},
    script = {"Parent", "Name", "FindFirstChild", "WaitForChild", "GetAttribute", "SetAttribute"},
